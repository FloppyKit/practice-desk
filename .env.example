# Copy to .env. Leave secrets empty until you set them on the host.
PORT=8090
PUBLIC_BASE_URL=https://book.example.com
SITE_PUBLIC_URL=https://example.com
PRACTICE_SITE_URL=https://example.com
PRACTICE_VIDEO_URL=https://meet.example.com
BOOKER_CONFIG=/app/config/event-types.yaml
PRACTICE_DIR=/data/logs/practice
REMIND_CRON_SECRET=
STAFF_SECRET=
SCRIBE_INGEST_TOKEN=
SCRIBE_TO=desk@example.com
# Chart files. proton (default) uses the notify bridge. gdrive and nextcloud use the same folder paths.
CHART_BACKEND=proton
GOOGLE_DRIVE_SA_FILE=
GOOGLE_DRIVE_ROOT_ID=
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
# Desk call. Empty leaves the button with no live call.
# Caller number: TWILIO_PHONE_NUMBER, or TWILIO_VOICE_FROM, or the practice profile phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VOICE_FROM=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_DESK_TWIML_APP_SID=
